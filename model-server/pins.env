# Model-server pins. Changing any value here triggers a full conformance-suite re-run
# (re-run rule, Yami 2026-11-13). Commit the change; the commit is the setup version.

# llama.cpp release tag. b12442 was the newest tag on 2026-11-16
# (git ls-remote https://github.com/ggml-org/llama.cpp, commit a001af915ee9488b9a9857d96f86cf19d73298ae).
LLAMA_TAG=b12442
# Asset name from .github/workflows/release.yml at that tag (job macos-cpu, build arm64, Metal embedded).
LLAMA_ASSET=llama-b12442-bin-macos-arm64.tar.gz
# Filled in after the first install: install-llama-cpp.sh prints it. Empty = not yet recorded.
LLAMA_SHA256=

# Server settings shared by every model, so the two co-candidates run on identical flags.
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080
LLAMA_CTX=131072
LLAMA_CACHE_RAM_MIB=16384
