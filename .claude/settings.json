{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(docker * prune)",
      "Bash(docker * prune *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push *--no-verify*)",
      "Bash(bash -*c *)",
      "Bash(sh -*c *)",
      "Bash(zsh -*c *)",
      "Bash(/bin/bash -*c *)",
      "Bash(/bin/sh -*c *)",
      "Bash(/bin/zsh -*c *)",
      "Bash(bash -c*)",
      "Bash(sh -c*)",
      "Bash(zsh -c*)",
      "Bash(/bin/bash -c*)",
      "Bash(/bin/sh -c*)",
      "Bash(/bin/zsh -c*)"
    ]
  }
}
