#!/bin/sh
# Refuses any push whose target is the remote branch `main`.
# Plain POSIX sh, no dependencies. Git passes one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
# The local ref is the rev as it was typed and can hold spaces
# (`HEAD@{1 hour ago}`); the other three fields never do. So the remote ref is
# read from the end of the line, never counted from the start.
protected="refs/heads/main"
status=0
while read -r line || [ -n "$line" ]; do
  [ -n "$line" ] || continue
  rest=${line% *}          # drop <remote sha>
  remote_ref=${rest##* }   # what is left ends with <remote ref>
  if [ "$remote_ref" = "$protected" ]; then
    echo "pre-push-block-main: refusing to push to main. Push a branch and open a PR." >&2
    status=1
  fi
done
exit $status
